# TG 打卡配置模板 (复制为 env.sh 后填写, 或直接用 setup.py 配置)
# 多个账号用英文逗号分隔, TG_API_ID / TG_API_HASH / TG_PHONE 三项数量必须一致
export TG_API_ID=""
export TG_API_HASH=""
export TG_PHONE=""
# 代理 (所有账号共用, 可选)
export TG_PROXY="socks5://127.0.0.1:7891"
# 打卡目标: bot名:命令, 多个用英文逗号分隔; 命令留空=按钮模式; 为空=默认 sheeridverifier_bot:/checkin
export TG_TARGETS=""
# 打卡报告推送 (可选)
export TG_NOTIFY_BOT_TOKEN=""
export TG_NOTIFY_CHAT_ID=""
